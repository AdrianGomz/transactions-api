{
  "info": {
    "_postman_id": "f0078c8d-e5bc-4229-bf54-27ccc4aa1735",
    "name": "Spin Transactions API - Local Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import this JSON file into Postman. Set the collection variable baseUrl (default http://localhost:8080). No authentication is required for the local app.\n\nThe authoritative API contract is docs/openapi.yaml; the transaction operations were generated from that spec and expanded here with the 25 request scenarios and checked-in WireMock fixtures from infra/wiremock/mappings. Keep this collection aligned when those files change. The health request checks the configured Actuator health endpoint.\n\nRequires the app, PostgreSQL, and default WireMock fixtures. A full collection run sends six transaction attempts. POST is not idempotent; each send creates a new attempt. The timeout scenario assumes a 3-second timeout per provider HTTP attempt. The server retries uncertain provider outcomes once, so a transaction request can make two provider HTTP calls; the first may already have executed without idempotency protection. Financial outcomes and provider responses here are simulated fixtures, not real account balances.\n\nFolders cover health, approvals/rejections, provider failures, validation, and queries. Each request has response assertions; valid error responses count as passing tests. No automatic retries or request chaining are configured."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Application origin, without a trailing slash. Use http://localhost:8082 if running on port 8082."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "01 - Application health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Expected: HTTP 200 and status UP. Requires a running app and reachable database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Application is healthy\", () => { pm.expect(body.status).to.eql(\"UP\"); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
