                "transactions"
              ]
            },
            "description": "Expected: HTTP 201, EXECUTED, balanceAfter 5500. Uses the exact checked-in WireMock fixture. Creates a transaction attempt on every send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-123456\",\n  \"type\": \"CREDIT\",\n  \"amount\": 1500.0,\n  \"currency\": \"MXN\",\n  \"description\": \"Credit test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Executed transaction\", () => { pm.expect(body.status).to.eql(\"EXECUTED\"); });",
                  "pm.test(\"Expected provider balance\", () => { pm.expect(body.balanceAfter).to.eql(5500); });",
                  "pm.test(\"Transaction identifiers present\", () => { pm.expect(body.id).to.be.a(\"string\").and.not.empty; pm.expect(body.providerTransactionId).to.be.a(\"string\").and.not.empty; });"
                ]
