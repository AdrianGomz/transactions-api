        {
          "name": "15 - Filter by account, status and type",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions?accountId=acc-123456&status=EXECUTED&type=CREDIT&page=0&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ],
              "query": [
                {
                  "key": "accountId",
                  "value": "acc-123456"
                },
                {
                  "key": "status",
                  "value": "EXECUTED"
                },
                {
                  "key": "type",
                  "value": "CREDIT"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
