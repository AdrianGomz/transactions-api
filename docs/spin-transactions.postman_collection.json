                  "pm.test(\"Paginated response\", () => { pm.expect(body.items).to.be.an(\"array\"); pm.expect(body.hasNext).to.be.a(\"boolean\"); });",
                  "pm.test(\"Expected page and limit\", () => { pm.expect(body.page).to.eql(0); pm.expect(body.limit).to.eql(20); pm.expect(body.items.length).to.be.at.most(20); });"
