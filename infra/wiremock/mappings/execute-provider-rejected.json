{
  "name": "Return HTTP 503 with a rejection body; outcome is uncertain",
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/execute",
    "headers": {
      "Content-Type": {
        "contains": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "equalToJson": {
          "accountId": "acc-provider-rejected",
          "type": "DEBIT",
          "amount": 1500.0,
          "currency": "MXN"
        }
      }
    ]
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "REJECTED",
      "code": "PROVIDER_UNAVAILABLE",
      "message": "The provider rejected this execution"
    }
  }
}
