{
  "name": "Return approval after the default client timeout",
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/execute",
    "headers": {
      "Content-Type": {
        "contains": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "equalToJson": {
          "accountId": "acc-timeout",
          "type": "DEBIT",
          "amount": 1500.0,
          "currency": "MXN"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 5000,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "transactionId": "txn-delayed",
      "status": "APPROVED",
      "balance": 2500.0,
      "executedAt": "2025-03-15T10:30:00Z"
    }
  }
}
